*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/

# Test, lint and coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# IDE and editor state
.vscode/
.idea/
*.swp
*.swo
*~

# Local environment and secrets
.env
.env.*
!.env.example

secrets/*.env
secrets/*.local
secrets/*.secret
secrets/*.json
secrets/*.pem
secrets/*.key

*.pem
*.key
*.p12
